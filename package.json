{
  "name": "php-get-set-generator",
  "displayName": "PHP Getters & Setters Generator",
  "description": "Smart and automated PHP getters and setters generator with full support for PHP 8.x properties, statics, and readonly classes.",
  "version": "1.0.3",
  "license": "MIT",
  "publisher": "artem-isamiddinov",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArtemIsamiddinov/php-get-set-generator-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "php",
    "get",
    "set",
    "class",
    "getter",
    "setter",
    "generator",
    "oop"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onCommand:php-get-set-generator.makeGetters",
    "onCommand:php-get-set-generator.makeSetters",
    "onCommand:php-get-set-generator.makeGettersAndSetters"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "PHP Getters & Setters Generator",
      "properties": {
        "php-get-set-generator.indentation": {
          "type": "string",
          "default": "4 spaces",
          "enum": [
            "2 spaces",
            "4 spaces",
            "1 tab"
          ],
          "markdownEnumDescriptions": [
            "%config.indentation.enum1description%",
            "%config.indentation.enum2description%",
            "%config.indentation.enum3description%"
          ],
          "markdownDescription": "%config.indentation.description%"
        },
        "php-get-set-generator.fluentSettersReturnType": {
          "type": "string",
          "default": "Class name",
          "enum": [
            "Class name",
            "static"
          ],
          "markdownEnumDescriptions": [
            "%config.fluentSettersReturnType.enum1description%",
            "%config.fluentSettersReturnType.enum2description%"
          ],
          "markdownDescription": "%config.fluentSettersReturnType.description%"
        },
        "php-get-set-generator.fluentSetters": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.fluentSetters.description%"
        },
        "php-get-set-generator.getterPrefix": {
          "type": "string",
          "default": "get",
          "markdownDescription": "%config.getterPrefix.description%"
        },
        "php-get-set-generator.getterBoolPrefix": {
          "type": "string",
          "default": "is",
          "markdownDescription": "%config.getterBoolPrefix.description%"
        },
        "php-get-set-generator.addVoidToSetters": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.addVoidToSetters.description%"
        }
      }
    },
    "submenus": [
      {
        "id": "php-get-set-generator.actions",
        "label": "PHP Getters and Setters"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == 'php'",
          "submenu": "php-get-set-generator.actions",
          "group": "navigation"
        }
      ],
      "php-get-set-generator.actions": [
        {
          "command": "php-get-set-generator.makeGetters",
          "group": "navigation1@1"
        },
        {
          "command": "php-get-set-generator.makeSetters",
          "group": "navigation1@2"
        },
        {
          "command": "php-get-set-generator.makeGettersAndSetters",
          "group": "navigation1@3"
        }
      ]
    },
    "commands": [
      {
        "command": "php-get-set-generator.makeGetters",
        "title": "Make Getters"
      },
      {
        "command": "php-get-set-generator.makeSetters",
        "title": "Make Setters"
      },
      {
        "command": "php-get-set-generator.makeGettersAndSetters",
        "title": "Make Getters & Setters"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}